# Copy this file to ".env" and replace the values. Docker Compose reads it automatically.
# For local development with run.sh, bun also reads a ".env" placed in backend/.

# Signs login tokens. Must have at least 32 characters. Generate with: openssl rand -hex 32
ACCESS_TOKEN_SECRET=

# Only used when the database volume is created for the first time. Changing it afterwards
# requires also running ALTER USER postgres PASSWORD '...' inside the database.
POSTGRES_PASSWORD=

# Optional. The domain the instance is served at (e.g. colcom.example), whose DNS must point to this
# machine with ports 80 and 443 open. With it, certbot gets a Let's Encrypt certificate and renews it,
# and nginx serves HTTPS (HTTP redirects to it) once the certificate exists. Leave it empty to serve
# plain HTTP, as for local testing.
DOMAIN=
# Optional. Where Let's Encrypt may write about the account (it no longer warns about expiries).
LETSENCRYPT_EMAIL=
# Optional. Any value uses Let's Encrypt's staging server, whose certificates browsers don't trust
# but whose rate limits are loose: for trying the setup. Remove the letsencrypt volume afterwards
# (docker volume rm colcom_letsencrypt) so the real certificate is requested.
# LETSENCRYPT_STAGING=1

# Optional. Origins allowed to call the API from another origin, comma-separated
# (e.g. https://colcom.example). nginx serves the site and the API under one origin, which needs
# none; outside production the Vite dev server (http://localhost:5173) is allowed when this is empty.
CORS_ORIGIN=

# Optional. Which proxies may report the client's IP (Express' "trust proxy": "loopback",
# a hop count like 1, addresses or subnets, true or false). The default, loopback, fits nginx on
# the same machine. Rate limits count per IP, so a wrong value lets clients pick their own.
TRUST_PROXY=

# Optional rate limits, as <requests>/<window> with s, m, h or d (e.g. 10/15m), or "off".
# Failed logins per IP (default 10/15m) and sign-ups per IP (default 5/1h):
RATE_LIMIT_LOGIN=
RATE_LIMIT_SIGN_UP=
# Topics, posts, critiques, edits and clones per user (default 30/10m):
RATE_LIMIT_CONTENTS=
# Votes, bookmarks and promotions per user (default 300/10m):
RATE_LIMIT_INTERACTIONS=

# Optional. Tags: anyone can use one, but creating them is limited so they can't be spammed.
# How old (in days) an account must be to create tags and vote on other topics' tags (default 7):
TAG_MIN_ACCOUNT_DAYS=
# New tags per user per day (default 3):
TAG_CREATE_PER_DAY=
# A new tag is provisional until it shows on this many topics by two or more authors (default 3)…
TAG_ACTIVATION_TOPICS=
# …and expires after this many days if it doesn't get there (default 30):
TAG_PROVISIONAL_DAYS=

# Optional. Where the built frontend sends API requests. Defaults to /api on the same origin,
# which nginx proxies to the backend. An address on another origin must also be allowed in the
# Content-Security-Policy's connect-src (nginx/headers.conf).
# VITE_API_ADDRESS=/api
